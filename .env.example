# Settings for obsidian-remote-mcp.
# Copy this file to .env, then edit .env:
#   cp .env.example .env && chmod 600 .env
# Never commit .env. It holds your tunnel token.

# --- Setup type ----------------------------------------------------------------
# Leave empty to serve a vault folder that's already on this machine.
# Set to obsidian-sync to keep a copy of your vault here with Obsidian Sync.
COMPOSE_PROFILES=

# --- Cloudflare ----------------------------------------------------------------
# Tunnel token from Cloudflare Zero Trust > Networks > Tunnels.
# It's a long string that starts with "eyJ". Required.
TUNNEL_TOKEN=

# --- Folders on this machine ---------------------------------------------------
# The vault folder that the MCP server reads and writes.
#   Local folder setup: the path of your existing vault, for example
#     /home/alex/Documents/MyVault, /Users/alex/Documents/MyVault,
#     or C:/Users/alex/Documents/MyVault on Windows.
#   Obsidian Sync setup: an empty folder for the synced copy.
VAULT_DIR=./data/vault
# Obsidian Sync setup only: stores your Obsidian login and sync state.
# Protect it like a password file.
OB_HOME_DIR=./data/ob-home
# The user and group ID that the containers run as. On Linux, use the owner of
# VAULT_DIR (run `id -u` and `id -g`). Docker Desktop and OrbStack map file
# ownership for you, so the default is fine there.
PUID=1000
PGID=1000

# --- MCP server ----------------------------------------------------------------
# true: offer read tools only. Clients can't change the vault.
MCPVAULT_READ_ONLY=false
# Folders to hide from search and folder listings, separated by commas,
# for example: Archive,Journal/Private
# This is not a security control. Clients can still open a file in these
# folders if they know its path.
MCPVAULT_EXCLUDE=
# Inbox-only mode only: the one folder that clients can write to.
INBOX_DIR=Inbox
# How long an idle client session stays open, in milliseconds.
SESSION_TIMEOUT_MS=3600000
# Gateway log level: debug, info, or none.
LOG_LEVEL=info

# --- Versions ------------------------------------------------------------------
# Tested versions. To update, change a version, then rebuild (see docs/operations.md).
NODE_IMAGE=node:22-bookworm-slim
OBSIDIAN_HEADLESS_VERSION=0.0.14
MCPVAULT_VERSION=0.18.3
SUPERGATEWAY_VERSION=4.2.1
CLOUDFLARED_VERSION=2026.10.7
